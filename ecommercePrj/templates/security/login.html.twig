{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary-accent: #4f46e5;
            --secondary-accent: #10b981;
            --light-layer: radial-gradient(ellipse at center, rgba(249, 250, 251, 0.98) 0%, rgba(229, 231, 235, 0.95) 100%);
            --glass-panel: rgba(255, 255, 255, 0.85);
            --glass-border: rgba(203, 213, 225, 0.3);
            --text-primary: rgba(15, 23, 42, 0.95);
            --text-secondary: rgba(51, 65, 85, 0.7);
            --card-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
        }

        body {
            background: 
                radial-gradient(circle at 25% 50%, #e0e7ff40 0%, transparent 50%),
                radial-gradient(circle at 75% 30%, #d1fae540 0%, transparent 50%),
                var(--light-layer);
            background-attachment: fixed;
            color: var(--text-primary);
            font-family: 'Geist', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
        }

        .auth-container {
            max-width: 450px;
            margin: 8rem auto;
            background: var(--glass-panel);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 20px;
            border: 1px solid var(--glass-border);
            box-shadow: var(--card-shadow);
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .auth-container:hover {
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            transform: translateY(-2px);
        }

        .role-badge {
            background: linear-gradient(90deg, #4f46e5, #7c3aed);
            color: white;
            padding: 8px 20px;
            border-radius: 30px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            box-shadow: 0 2px 10px rgba(79, 70, 229, 0.2);
        }

        .form-control {
            border-radius: 12px;
            padding: 14px 20px;
            border: 1px solid var(--glass-border);
            background: rgba(255, 255, 255, 0.7);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .form-control:focus {
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
            border-color: #818cf8;
            background: white;
        }

        .input-group-text {
            background: rgba(255, 255, 255, 0.7);
            border: 1px solid var(--glass-border);
            border-right: none;
            color: var(--text-secondary);
        }

        .btn-login {
            background: linear-gradient(90deg, #4f46e5, #7c3aed);
            border: none;
            padding: 14px;
            font-weight: 500;
            letter-spacing: 0.5px;
            border-radius: 12px;
            transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
            box-shadow: 0 4px 15px rgba(79, 70, 229, 0.2);
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(79, 70, 229, 0.3);
            background-position: right center;
        }

        .auth-links a {
            color: var(--text-secondary);
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .auth-links a:hover {
            color: var(--primary-accent);
            transform: translateX(4px);
        }

        .shake-error {
            animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-8px); }
            75% { transform: translateX(8px); }
        }

        .floating-shape {
            position: absolute;
            filter: blur(40px);
            opacity: 0.15;
            z-index: 0;
        }

        .shape-1 {
            width: 200px;
            height: 200px;
            background: #818cf8;
            top: 20%;
            left: 10%;
            border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
            animation: float 12s ease-in-out infinite;
        }

        .shape-2 {
            width: 150px;
            height: 150px;
            background: #34d399;
            bottom: 10%;
            right: 15%;
            border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
            animation: float 8s ease-in-out infinite reverse;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0); }
            25% { transform: translate(20px, 20px); }
            50% { transform: translate(0, 30px); }
            75% { transform: translate(-20px, 10px); }
        }

        @media (max-width: 768px) {
            .auth-container {
                margin: 5rem auto;
                width: 90%;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="position-relative" style="min-height: 100vh;">
    <div class="floating-shape shape-1"></div>
    <div class="floating-shape shape-2"></div>
    
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">
                <i class="fas fa-arrow-left me-2"></i>E-Commerce
            </a>
        </div>
    </nav>

    <div class="auth-container">
        <div class="p-4 p-lg-5 position-relative" style="z-index: 2;">
            <h2 class="text-center mb-4 fw-bold" style="background: linear-gradient(90deg, #1e293b, #475569); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;">
                Connexion
            </h2>

            {% if app.request.get('role') %}
                <div class="role-badge mb-4 mx-auto" style="width: fit-content;">
                    <i class="fas fa-user-tag"></i>
                    <span>{{ app.request.get('role')|capitalize }}</span>
                </div>
            {% endif %}

            {% if error %}
                <div class="alert alert-danger shake-error d-flex align-items-center" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-4">
                    <label class="form-label text-muted mb-2">Identifiant</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-envelope"></i>
                        </span>
                        <input type="text" 
                               name="_username" 
                               value="{{ last_username }}" 
                               class="form-control"
                               placeholder="email@exemple.com"
                               required>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted mb-2">Mot de passe</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-lock"></i>
                        </span>
                        <input type="password" 
                               name="_password" 
                               class="form-control" 
                               placeholder="••••••••" 
                               required>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-login w-100 mb-4 text-white">
                    <i class="fas fa-sign-in-alt me-2"></i>Se connecter
                </button>

                <div class="auth-links text-center">
                    {% if app.request.get('role') == 'client' %}
                        <a href="{{ path('client_register') }}" class="d-block mb-2">
                            <i class="fas fa-user-plus me-2"></i>Créer un compte Client
                        </a>
                    {% elseif app.request.get('role') == 'vendor' %}
                        <a href="{{ path('vendor_register') }}" class="d-block mb-2">
                            <i class="fas fa-store me-2"></i>Devenir Vendeur
                        </a>
                    {% endif %}

                    <a href="#" class="small">
                        <i class="fas fa-question-circle me-2"></i>Mot de passe oublié ?
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Micro-interaction pour les boutons
        document.querySelector('.btn-login').addEventListener('mousemove', (e) => {
            const rect = e.target.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            e.target.style.setProperty('--mouse-x', ${x}px);
            e.target.style.setProperty('--mouse-y', ${y}px);
        });
    </script>
{% endblock %}