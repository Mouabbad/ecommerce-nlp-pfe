{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background-color: #f5f7ff;
            font-family: 'Poppins', sans-serif;
        }
        
        .container {
            max-width: 1200px;
            padding: 20px;
        }
        
        h1 {
            color: #212529;
            font-weight: 600;
            margin-bottom: 1.5rem;
        }
        
        .btn {
            font-weight: 500;
            padding: 10px 20px;
            border-radius: 8px;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: none;
        }
        
        .btn i {
            font-size: 0.9em;
        }
        
        .btn-secondary {
            background-color: #6c757d;
            color: white;
        }
        
        .btn-secondary:hover {
            background-color: #5a6268;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(108, 117, 125, 0.2);
        }
        
        .btn-success {
            background-color: #06d6a0;
        }
        
        .btn-success:hover {
            background-color: #05c493;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(6, 214, 160, 0.2);
        }
        
        .btn-warning {
            background-color: #ffd166;
            color: #212529;
        }
        
        .btn-warning:hover {
            background-color: #ffc837;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 209, 102, 0.2);
        }
        
        .btn-danger {
            background-color: #ff6b6b;
        }
        
        .btn-danger:hover {
            background-color: #e55c5c;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 107, 107, 0.2);
        }
        
        .btn-sm {
            padding: 6px 12px;
            font-size: 0.875rem;
        }
        
        .table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            background-color: white;
        }
        
        .table thead th {
            background-color: #4361ee;
            color: white;
            border: none;
            font-weight: 500;
            padding: 12px 15px;
        }
        
        .table tbody td {
            padding: 12px 15px;
            border-bottom: 1px solid #e9ecef;
        }
        
        .table tbody tr:last-child td {
            border-bottom: none;
        }
        
        .table-striped tbody tr:nth-of-type(odd) {
            background-color: rgba(248, 249, 250, 0.5);
        }
        
        .table-striped tbody tr:hover {
            background-color: rgba(67, 97, 238, 0.05);
        }
        
        .badge-role {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 500;
            margin-right: 5px;
        }
        
        .badge-admin {
            background-color: rgba(67, 97, 238, 0.2);
            color: #4361ee;
        }
        
        .badge-vendor {
            background-color: rgba(6, 214, 160, 0.2);
            color: #06d6a0;
        }
        
        .badge-client {
            background-color: rgba(108, 117, 125, 0.2);
            color: #6c757d;
        }
        
        .action-buttons {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        
        form {
            display: inline;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des utilisateurs</h1>
        <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour au dashboard
        </a>
    </div>

    <div class="mb-4">
        <a href="{{ path('admin_user_add') }}" class="btn btn-success">
            <i class="fas fa-user-plus"></i> Ajouter un utilisateur
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom complet</th>
                    <th>Email</th>
                    <th>Rôles</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>{{ user.firstName }} {{ user.lastName }}</td>
                        <td>{{ user.email }}</td>
                        <td>
                            {% for role in user.roles %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="badge-role badge-admin">Admin</span>
                                {% elseif role == 'ROLE_VENDOR' %}
                                    <span class="badge-role badge-vendor">Vendeur</span>
                                {% elseif role == 'ROLE_CLIENT' %}
                                    <span class="badge-role badge-client">Client</span>
                                {% else %}
                                    <span class="badge-role">{{ role }}</span>
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td>
                            <div class="action-buttons">
                                <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                                <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Confirmer la suppression ?');">
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash-alt"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Aucun utilisateur trouvé</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}