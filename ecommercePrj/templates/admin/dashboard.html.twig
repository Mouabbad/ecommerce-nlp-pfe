{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background-color: #f5f7ff;
            font-family: 'Poppins', sans-serif;
        }
        
        .container {
            max-width: 1200px;
        }
        
        .btn {
            font-weight: 500;
            padding: 10px 20px;
            border-radius: 8px;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        
        .btn i {
            font-size: 0.9em;
        }
        
        .btn-primary {
            background-color: #4361ee;
            border-color: #4361ee;
        }
        
        .btn-primary:hover {
            background-color: #3a56d4;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(58, 86, 212, 0.2);
        }
        
        .btn-success {
            background-color: #06d6a0;
            border-color: #06d6a0;
        }
        
        .btn-success:hover {
            background-color: #05c493;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(6, 214, 160, 0.2);
        }
        
        .btn-danger {
            background-color: #ff6b6b;
            border-color: #ff6b6b;
        }
        
        .btn-danger:hover {
            background-color: #e55c5c;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 107, 107, 0.2);
        }
        
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }
        
        .card:hover {
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
        }
        
        .table {
            border-radius: 10px;
            overflow: hidden;
        }
        
        .table thead th {
            background-color: #4361ee;
            color: white;
            border: none;
            font-weight: 500;
        }
        
        .badge {
            font-weight: 500;
            padding: 6px 10px;
            border-radius: 20px;
        }
        
        .alert {
            border-radius: 8px;
            border: none;
        }
        
        h1, h2, h3 {
            color: #212529;
            font-weight: 600;
        }
        
        h1 {
            font-size: 2rem;
            margin-bottom: 1.5rem;
        }
        
        h2 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            position: relative;
            padding-bottom: 10px;
        }
        
        h2:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 60px;
            height: 3px;
            background: #4361ee;
            border-radius: 3px;
        }
        
        h3 {
            font-size: 1.2rem;
            margin: 1.5rem 0 1rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Dashboard Admin</h1>
        <a href="{{ path('app_logout') }}" class="btn btn-danger">
            <i class="fas fa-sign-out-alt"></i> Se déconnecter
        </a>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="{{ path('admin_users') }}" class="btn btn-primary">
            <i class="fas fa-users-cog"></i> Gérer les utilisateurs
        </a>
        <a href="{{ path('admin_user_add') }}" class="btn btn-success">
            <i class="fas fa-user-plus"></i> Ajouter un utilisateur
        </a>
    </div>

    <!-- Clients Section -->
    <div class="card">
        <div class="card-body">
            <h2>Clients ({{ clients|length }})</h2>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom complet</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for client in clients %}
                            <tr>
                                <td>{{ client.id }}</td>
                                <td>{{ client.firstName }} {{ client.lastName }}</td>
                                <td>{{ client.email }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center py-3 text-muted">Aucun client trouvé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Vendeurs Stats Section -->
    <div class="card">
        <div class="card-body">
            <h2>Statistiques Produits par Vendeur</h2>
            
            {% for data in vendeursData %}
                <div class="mb-4">
                    <h3>
                        <i class="fas fa-user-tie text-primary mr-2"></i>
                        Vendeur : {{ data.vendeur.firstName }} {{ data.vendeur.lastName }}
                    </h3>
                    
                    {% if data.produitsStats|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Produit</th>
                                        <th>Commentaires</th>
                                        <th>Moyenne</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for ps in data.produitsStats %}
                                        <tr>
                                            <td>{{ ps.produit.nom }}</td>
                                            <td>{{ ps.commentsCount }}</td>
                                            <td>
                                                {% if ps.averageScore %}
                                                    <span class="badge bg-{{ ps.averageScore >= 3 ? 'success' : (ps.averageScore >= 2 ? 'warning' : 'danger') }}">
                                                        {{ ps.averageScore|number_format(2) }}
                                                    </span>
                                                {% else %}
                                                    <span class="badge bg-secondary">N/A</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="alert alert-info mb-0">Pas de produits pour ce vendeur</div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Negative Comments Section -->
    <div class="card">
        <div class="card-body">
            <h2>Commentaires négatifs non propriétaires</h2>
            
            {% if negativeComments|length > 0 %}
                <div class="row">
                    {% for comment in negativeComments %}
                        <div class="col-md-6 mb-3">
                            <div class="border-start border-danger ps-3 py-2 h-100">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <strong>Produit: {{ comment.produit.nom }} (ID: {{ comment.produit.id }})</strong>
                                    <span class="badge bg-{{ comment.score >= 0.5 ? 'success' : (comment.score >= 0.3 ? 'warning' : 'danger') }}">
                                        Score: {{ comment.score|number_format(2) }}
                                    </span>
                                </div>
                                <p class="mb-3">{{ comment.content }}</p>
                                <form method="post" action="{{ path('admin_comment_delete', {'id': comment.id}) }}" onsubmit="return confirm('Confirmer suppression ?');">
                                    <button class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash-alt mr-1"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="alert alert-success mb-0">Aucun commentaire négatif non propriétaire</div>
            {% endif %}
        </div>
    </div>

    <!-- Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show mb-4">
            <i class="fas fa-check-circle mr-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show mb-4">
            <i class="fas fa-exclamation-circle mr-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
</div>
{% endblock %}