{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Fond blanc pur */
        body {
            background-color: #ffffff;
            font-family: 'Segoe UI', system-ui, sans-serif;
            padding: 20px;
        }
        
        /* Carte avec nuance très légère de bleu */
        .form-card {
            max-width: 700px;
            margin: 0 auto;
            padding: 30px;
            background-color: #f8fafd; /* Bleu très pâle presque blanc */
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            border: 1px solid #eef2f6; /* Bordure bleue très claire */
        }
        
        h1 {
            color: #2d3748;
            margin-bottom: 25px;
            font-weight: 600;
            font-size: 24px;
        }
        
        /* Styles des champs (inchangés fonctionnellement) */
        input, textarea, select {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            margin-bottom: 15px;
            background: white;
            font-size: 16px;
        }
        
        button[type="submit"] {
            background: #4f46e5;
            color: white;
            padding: 12px 24px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            transition: background 0.2s;
        }
        
        button[type="submit"]:hover {
            background: #4338ca;
        }
        
        a {
            color: #4f46e5;
            text-decoration: none;
            display: inline-block;
            margin-top: 20px;
            font-size: 15px;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="form-card">
        <h1>Ajouter un produit</h1>
        
        {# VOTRE CODE ORIGINAL - STRICTEMENT IDENTIQUE #}
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit">Ajouter</button>
        {{ form_end(form) }}
        
        <a href="{{ path('vendor_dashboard') }}">Retour à la liste</a>
    </div>
{% endblock %}