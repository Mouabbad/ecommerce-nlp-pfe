<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}E-commerce{% endblock %}</title>
    <link rel="icon" href="favicon.ico">

    {# Bootstrap CSS #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    {# CSS injecté via Webpack Encore #}
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>
<body>

    {# Affichage des messages flash #}
    <div class="container mt-3">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    {# Contenu principal #}
    <main class="container mt-4">
        {% block body %}
        {% endblock %}
    </main>

    {# JS injecté via Webpack Encore #}
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}

        <script>
            // Attendre que la page soit chargée
            document.addEventListener('DOMContentLoaded', () => {
                // Sélectionner tous les messages flash (avec la classe .alert)
                const alerts = document.querySelectorAll('.alert');

                // Parcourir chaque message
                alerts.forEach(alert => {
                    // Après 3 secondes, cacher le message avec une transition
                    setTimeout(() => {
                        alert.style.transition = 'opacity 0.3s ease';
                        alert.style.opacity = '0';
                        // Après la transition, on supprime complètement l'élément du DOM
                        setTimeout(() => alert.remove(), 300);
                    }, 3000); // 3000ms = 3 secondes
                });
            });
        </script>
    {% endblock %}

    {# Bootstrap JS #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>
</html>
