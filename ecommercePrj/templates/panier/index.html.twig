{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Couleurs personnalisées */
        :root {
            --primary: #6c5ce7;
            --primary-soft: rgba(108, 92, 231, 0.1);
            --pink: #fd79a8;
            --pink-soft: rgba(253, 121, 168, 0.1);
            --dark: #2d3436;
            --dark-soft: rgba(45, 52, 54, 0.1);
            --gray: #dfe6e9;
            --light: #f5f6fa;
        }

        body {
            background-color: var(--light);
            font-family: 'Inter', sans-serif;
        }

        /* En-tête */
        .page-header {
            border-bottom: 3px solid var(--primary);
            padding-bottom: 0.5rem;
            margin-bottom: 2.5rem;
        }

        .page-header h1 {
            font-weight: 700;
            color: var(--dark);
        }

        .header-underline {
            height: 4px;
            width: 60px;
            background: linear-gradient(90deg, var(--primary), var(--pink));
            border-radius: 2px;
        }

        /* Carte principale */
        .soft-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            transition: all 0.3s ease;
        }

        /* Boutons */
        .btn-soft {
            background-color: var(--primary-soft);
            color: var(--primary);
            border: none;
            transition: all 0.2s;
        }

        .btn-soft:hover {
            background-color: var(--primary);
            color: white;
        }

        .btn-soft-pink {
            background-color: var(--pink-soft);
            color: var(--pink);
            border: none;
        }

        .btn-soft-pink:hover {
            background-color: var(--pink);
            color: white;
        }

        /* Tableau */
        .cart-table {
            border-collapse: separate;
            border-spacing: 0;
        }

        .cart-table thead th {
            background-color: var(--light);
            color: var(--dark);
            font-weight: 600;
            padding: 1rem;
            border: none;
        }

        .cart-table tbody tr {
            transition: all 0.2s;
        }

        .cart-table tbody tr:hover {
            background-color: var(--light);
        }

        .cart-table td {
            padding: 1.5rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid var(--gray);
        }

        /* Boutons quantité */
        .quantity-btn {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background-color: var(--light);
            color: var(--dark);
            border-radius: 50%;
            transition: all 0.2s;
        }

        .quantity-btn:hover {
            background-color: var(--primary);
            color: white;
        }

        /* Image produit */
        .product-img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid var(--gray);
        }

        /* Section total */
        .summary-card {
            background-color: var(--light);
            border-radius: 10px;
            padding: 1.5rem;
        }

        .total-row {
            border-top: 2px solid var(--gray);
            padding-top: 1rem;
        }

        /* Panier vide */
        .empty-cart {
            padding: 4rem 2rem;
            text-align: center;
        }

        .empty-cart-icon {
            font-size: 5rem;
            color: var(--pink);
            margin-bottom: 1.5rem;
        }

        /* Animation */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .fade-in {
            animation: fadeIn 0.4s ease-out forwards;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container py-5 fade-in">
    {# En-tête #}
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div class="page-header">
            <h1 class="display-5 mb-3">Votre Panier</h1>
            <div class="header-underline"></div>
        </div>
        <a href="{{ path('client_dashboard') }}" class="btn btn-soft rounded-pill px-4">
            <i class="bi bi-arrow-left me-2"></i>Retour
        </a>
    </div>

    {# Contenu du panier #}
    <div class="soft-card">
        {% if paniers|length > 0 %}
            <div class="table-responsive">
                <table class="table cart-table">
                    <thead>
                        <tr>
                            <th>Produit</th>
                            <th class="text-center">Quantité</th>
                            <th class="text-end">Prix unitaire</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set total_panier = 0 %}
                        
                        {% for item in paniers %}
                            {% set item_total = item.produit.prix * item.quantite %}
                            {% set total_panier = total_panier + item_total %}
                            
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="{{ item.produit.imageUrl ?? 'https://via.placeholder.com/70' }}" 
                                             class="product-img me-3" 
                                             alt="{{ item.produit.nom }}">
                                        <div>
                                            <h6 class="mb-1">{{ item.produit.nom }}</h6>
                                            <small class="text-muted">Ref: PROD{{ item.id }}</small>
                                        </div>
                                    </div>
                                </td>
                                
                                <td class="text-center">
                                    <div class="d-flex justify-content-center align-items-center">
                                        <a href="{{ path('panier_update_quantity', { id: item.id, action: 'decrease' }) }}" 
                                           class="quantity-btn me-2">
                                            <i class="bi bi-dash"></i>
                                        </a>
                                        <span class="mx-2 fw-bold">{{ item.quantite }}</span>
                                        <a href="{{ path('panier_update_quantity', { id: item.id, action: 'increase' }) }}" 
                                           class="quantity-btn ms-2">
                                            <i class="bi bi-plus"></i>
                                        </a>
                                    </div>
                                </td>

                                <td class="text-end">{{ item.produit.prix }} DH</td>
                                <td class="text-end fw-bold text-primary">{{ item_total }} DH</td>
                                
                                <td class="text-end">
                                    <a href="{{ path('panier_delete', { id: item.id }) }}" 
                                       class="btn btn-soft-pink btn-sm rounded-pill px-3">
                                        <i class="bi bi-trash me-1"></i>Supprimer
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            {# Récapitulatif #}
            <div class="p-4">
                <div class="row justify-content-end">
                    <div class="col-md-5">
                        <div class="summary-card">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Sous-total:</span>
                                <span class="fw-medium">{{ total_panier }} DH</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Livraison:</span>
                                <span class="fw-medium">Gratuite</span>
                            </div>
                            <div class="d-flex justify-content-between total-row pt-3">
                                <span class="h5 mb-0">Total:</span>
                                <span class="h4 mb-0 fw-bold text-primary">{{ total_panier }} DH</span>
                            </div>

                           <a href="{{ path('client_order_checkout') }}" class="btn btn-soft-primary w-100 mt-4 py-3 fw-medium rounded-pill">
                            Passer commande <i class="bi bi-arrow-right ms-2"></i>
                               </a>


                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            {# Panier vide #}
            <div class="empty-cart">
                <div class="empty-cart-icon">
                    <i class="bi bi-cart-x"></i>
                </div>
                <h3 class="mb-3">Votre panier est vide</h3>
                <p class="text-muted mb-4">Commencez à shopper pour le remplir</p>
                <a href="{{ path('boutique') }}" class="btn btn-primary px-5 rounded-pill">
                    Découvrir la boutique <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}