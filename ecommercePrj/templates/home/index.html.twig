{% extends 'base.html.twig' %}

{% block stylesheets %}
    <style>
        :root {
            --primary-accent: #4f46e5;
            --secondary-accent: #10b981;
            --light-layer: radial-gradient(ellipse at center, rgba(249, 250, 251, 0.98) 0%, rgba(229, 231, 235, 0.95) 100%);
            --glass-panel: rgba(255, 255, 255, 0.7);
            --glass-border: rgba(203, 213, 225, 0.3);
            --glass-highlight: rgba(255, 255, 255, 0.5);
            --text-primary: rgba(15, 23, 42, 0.95);
            --text-secondary: rgba(51, 65, 85, 0.7);
            --card-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
        }

        @font-face {
            font-family: 'Geist';
            src: url('https://assets.codepen.io/605876/GeistVF.ttf') format('truetype');
        }

        body {
            background: 
                radial-gradient(circle at 25% 50%, #e0e7ff40 0%, transparent 50%),
                radial-gradient(circle at 75% 30%, #d1fae540 0%, transparent 50%),
                var(--light-layer);
            background-attachment: fixed;
            color: var(--text-primary);
            font-family: 'Geist', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            overscroll-behavior-y: none;
        }

        .navbar {
            background: var(--glass-panel);
            backdrop-filter: blur(16px) saturate(180%);
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            border-bottom: 1px solid var(--glass-border);
            box-shadow: var(--card-shadow);
        }

        .navbar-brand {
            font-weight: 600;
            letter-spacing: -0.5px;
            background: linear-gradient(90deg, #4f46e5, #7c3aed);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            position: relative;
        }

        .navbar-brand::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, #4f46e5, #7c3aed);
            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .navbar-brand:hover::after {
            transform: scaleX(1);
            transform-origin: left;
        }

        .nav-link {
            position: relative;
            color: var(--text-secondary) !important;
            font-weight: 450;
            padding: 0.5rem 1rem !important;
            margin: 0 0.25rem;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .nav-link::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 1rem;
            right: 1rem;
            height: 1px;
            background: currentColor;
            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .nav-link:hover {
            color: var(--text-primary) !important;
        }

        .nav-link:hover::before {
            transform: scaleX(1);
            transform-origin: left;
        }

        .hero-section {
            padding-top: 20vh;
            padding-bottom: 15vh;
            position: relative;
        }

        .hero-content {
            max-width: 720px;
            margin: 0 auto;
            position: relative;
            z-index: 2;
        }

        .title-text {
            font-size: clamp(2.5rem, 6vw, 4rem);
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: -0.05em;
            margin-bottom: 1.5rem;
            background: linear-gradient(90deg, #1e293b, #475569);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            position: relative;
        }

        .title-text::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 80px;
            height: 4px;
            background: linear-gradient(90deg, #4f46e5, #7c3aed);
            border-radius: 2px;
        }

        .lead-text {
            font-size: clamp(1rem, 3vw, 1.25rem);
            line-height: 1.6;
            color: var(--text-secondary);
            font-weight: 400;
            max-width: 560px;
            margin: 0 auto 3rem;
            opacity: 0;
            animation: fadeInUp 0.8s 0.3s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        .auth-buttons {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            max-width: 280px;
            margin: 0 auto;
            opacity: 0;
            animation: fadeInUp 0.8s 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        .auth-button {
            position: relative;
            padding: 1rem 2rem;
            border-radius: 12px;
            border: none;
            background: var(--glass-panel);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            color: var(--text-primary);
            font-weight: 500;
            letter-spacing: -0.01em;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
            box-shadow: 
                var(--card-shadow),
                inset 0 0 0 1px var(--glass-border),
                inset 0 0 24px rgba(255, 255, 255, 0.3);
        }

        .auth-button::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, 
                rgba(79, 70, 229, 0.1) 0%, 
                rgba(124, 58, 237, 0.1) 100%);
            z-index: -1;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .auth-button:hover {
            transform: translateY(-2px);
            box-shadow: 
                0 8px 16px rgba(0, 0, 0, 0.08),
                inset 0 0 0 1px var(--glass-border),
                inset 0 0 24px rgba(255, 255, 255, 0.4);
        }

        .auth-button:hover::before {
            opacity: 1;
        }

        .auth-button i {
            margin-right: 10px;
            font-size: 1.1em;
            color: var(--primary-accent);
        }

        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive */
        @media (max-width: 768px) {
            .hero-section {
                padding-top: 15vh;
                padding-bottom: 10vh;
            }
            
            .auth-buttons {
                max-width: 100%;
            }
        }

        /* Floating decoration */
        .floating-shape {
            position: absolute;
            filter: blur(40px);
            opacity: 0.2;
            z-index: 1;
        }

        .shape-1 {
            width: 200px;
            height: 200px;
            background: #818cf8;
            top: 20%;
            left: 10%;
            border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
            animation: float 12s ease-in-out infinite;
        }

        .shape-2 {
            width: 150px;
            height: 150px;
            background: #34d399;
            bottom: 10%;
            right: 15%;
            border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
            animation: float 8s ease-in-out infinite reverse;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0); }
            25% { transform: translate(20px, 20px); }
            50% { transform: translate(0, 30px); }
            75% { transform: translate(-20px, 10px); }
        }
    </style>
{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="#">E-Commerce</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Accueil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">À propos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Contact</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="hero-section">
    <div class="floating-shape shape-1"></div>
    <div class="floating-shape shape-2"></div>
    
    <div class="container text-center">
        <div class="hero-content">
            <h1 class="title-text">Bienvenue sur notre Plateforme</h1>
            <p class="lead-text">Découvrez une expérience d'achat unique adaptée à vos besoins professionnels et personnels</p>
            
            <div class="auth-buttons">
                <a href="{{ path('app_login', {'role': 'client'}) }}" class="auth-button">
                    <i class="fas fa-user"></i> Connexion Client
                </a>
                <a href="{{ path('app_login', {'role': 'vendor'}) }}" class="auth-button">
                    <i class="fas fa-store"></i> Connexion Vendeur
                </a>
                <a href="{{ path('app_login', {'role': 'admin'}) }}" class="auth-button">
                    <i class="fas fa-lock"></i> Connexion Admin
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <!-- Font Awesome -->
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    
    <script>
        // Micro-interactions
        document.querySelectorAll('.auth-button').forEach(button => {
            button.addEventListener('mousemove', (e) => {
                const rect = button.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                button.style.setProperty('--mouse-x', ${x}px);
                button.style.setProperty('--mouse-y', ${y}px);
            });
            
            button.addEventListener('mouseleave', () => {
                button.style.removeProperty('--mouse-x');
                button.style.removeProperty('--mouse-y');
            });
        });

        // Navbar effect
        window.addEventListener('scroll', () => {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY > 20) {
                navbar.style.background = 'rgba(255, 255, 255, 0.85)';
                navbar.style.boxShadow = '0 4px 30px rgba(0, 0, 0, 0.1)';
            } else {
                navbar.style.background = 'var(--glass-panel)';
                navbar.style.boxShadow = 'var(--card-shadow)';
            }
        });
    </script>
{% endblock %}